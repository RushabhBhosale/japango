# Public mobile URL only; never place API keys in EXPO_PUBLIC variables.
EXPO_PUBLIC_API_BASE_URL=
# Expo project ID used to obtain a device push token. This is public, not a secret.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Public OAuth client IDs for native Google Sign-In and the Google Picker.
# Android requires both the Android client (package com.rushi2303.japango plus
# the exact debug/release SHA-1) and a Web application client from the same
# Google Cloud project. Enable the Google Picker, Drive, and Docs APIs.
# JapanGo requests only the non-sensitive drive.file scope.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# The mobile client only reads published Lessons V2 content through the backend.
# Do not put SUPABASE_SERVICE_ROLE_KEY or Ollama settings in this file.

# The optional Next.js OCR-retrieval backend has its own server-only template:
# backend/.env.example (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and embedding settings).

# Server-only AI configuration (set these in the backend/server environment).
AI_PROVIDER_PRIMARY=
AI_MODEL_PRIMARY=
AI_BASE_URL_PRIMARY=
AI_API_KEY_PRIMARY=
AI_PROVIDER_BACKUP_1=
AI_MODEL_BACKUP_1=
AI_BASE_URL_BACKUP_1=
AI_API_KEY_BACKUP_1=
AI_PROVIDER_BACKUP_2=
AI_MODEL_BACKUP_2=
AI_BASE_URL_BACKUP_2=
AI_API_KEY_BACKUP_2=
AI_REQUEST_TIMEOUT_MS=12000
AI_COOLDOWN_SECONDS=45
