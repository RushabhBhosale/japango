# Supabase server credentials. Do not expose the service role key to Expo clients.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Lessons V2 starts as a single-user local-development console. It deliberately
# has no sign-in flow. Never deploy with this setting exposed to the public.
# Future deployments will use `supabase` through the authorization adapter.
LESSONS_V2_AUTH_MODE=disabled

# Native Ollama embeddings. Keep Ollama reachable from the machine running the
# backend; browser and Expo clients never call it directly.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b

# qwen3-embedding:4b emits 2,560 dimensions by default. This must match the
# halfvec dimension in supabase/migrations/20260802000000_japanese_ocr_retrieval.sql.
JAPANESE_EMBEDDING_DIMENSIONS=2560

# Existing AI teacher settings are independent from local retrieval embeddings.
AI_PROVIDER_PRIMARY=
AI_MODEL_PRIMARY=
AI_BASE_URL_PRIMARY=
AI_API_KEY_PRIMARY=
AI_PROVIDER_BACKUP_1=
AI_MODEL_BACKUP_1=
AI_BASE_URL_BACKUP_1=
AI_API_KEY_BACKUP_1=
AI_PROVIDER_BACKUP_2=
AI_MODEL_BACKUP_2=
AI_BASE_URL_BACKUP_2=
AI_API_KEY_BACKUP_2=
AI_REQUEST_TIMEOUT_MS=12000
AI_COOLDOWN_SECONDS=45
