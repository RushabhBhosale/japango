# Supabase server credentials. Do not expose the service role key to Expo clients.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Lessons V2 starts as a single-user local-development console. It deliberately
# has no sign-in flow. Never deploy with this setting exposed to the public.
# Future deployments will use `supabase` through the authorization adapter.
LESSONS_V2_AUTH_MODE=disabled

# Audio Lessons use the same backend-only Supabase credentials and local-dev
# management boundary. "system" keeps generated drafts playable with device
# voices; "http" calls a private compatible TTS service and is required before
# publishing section-level audio files.
AUDIO_TTS_PROVIDER=system
AUDIO_TTS_BASE_URL=
AUDIO_TTS_API_KEY=

# Optional reviewed bindings used only by `npm run audio-lessons:pilot`.
# Pilots are always created as drafts; validate and review before publishing.
AUDIO_PILOT_SOURCE_CHUNK_ID=
AUDIO_PILOT_SOURCE_PATH=
AUDIO_PILOT_PATTERN_ID=
AUDIO_PILOT_VOCABULARY_IDS=
AUDIO_PILOT_GRAMMAR_IDS=
AUDIO_PILOT_KANJI_IDS=
AUDIO_PILOT_RELATED_LESSON_IDS=

# Native Ollama embeddings. Keep Ollama reachable from the machine running the
# backend; browser and Expo clients never call it directly.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b

# qwen3-embedding:4b emits 2,560 dimensions by default. This must match the
# halfvec dimension in supabase/migrations/20260802000000_japanese_ocr_retrieval.sql.
JAPANESE_EMBEDDING_DIMENSIONS=2560

# AI teacher and Lessons V2 authoring models. Lesson generation is backend-only
# and uses PRIMARY, then the configured backups. Use the strongest JSON-capable,
# Japanese-capable model available from your OpenAI-compatible provider.
AI_PROVIDER_PRIMARY=
AI_MODEL_PRIMARY=
AI_BASE_URL_PRIMARY=
AI_API_KEY_PRIMARY=
AI_PROVIDER_BACKUP_1=
AI_MODEL_BACKUP_1=
AI_BASE_URL_BACKUP_1=
AI_API_KEY_BACKUP_1=
AI_PROVIDER_BACKUP_2=
AI_MODEL_BACKUP_2=
AI_BASE_URL_BACKUP_2=
AI_API_KEY_BACKUP_2=
AI_REQUEST_TIMEOUT_MS=12000
AI_LESSON_TIMEOUT_MS=90000
AI_COOLDOWN_SECONDS=45

# AI Chat uses OpenRouter only from the backend. The mobile client receives
# only response data through EXPO_PUBLIC_API_BASE_URL, never this key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_CHAT_MODEL_PRIMARY=openrouter/free
AI_CHAT_MODEL_BACKUP_1=openai/gpt-oss-20b:free
AI_CHAT_MODEL_BACKUP_2=google/gemma-4-26b-a4b-it:free
AI_CHAT_REQUEST_TIMEOUT_MS=30000
AI_CHAT_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
AI_CHAT_EMBEDDING_TIMEOUT_MS=12000

# Daily Reading uses the same OpenAI-compatible provider registry. For
# OpenRouter, set AI_PROVIDER_PRIMARY=openrouter and use this base URL:
# AI_BASE_URL_PRIMARY=https://openrouter.ai/api/v1
# Keep the API key server-side in AI_API_KEY_PRIMARY.
CRON_SECRET=
DAILY_READING_TIME_ZONE=Asia/Tokyo
# The protected proactive-chat cron shares CRON_SECRET and uses the Supabase
# service-role credentials above. It sends no more than one message per user/day.

# Optional local path to the reviewed sentence corpus. It is usage/collocation
# grounding only; generated lesson wording is always original. When omitted,
# the backend checks the normal monorepo paths and continues without it if the
# corpus is not deployed.
JAPANGO_SENTENCE_CORPUS_DIR=
