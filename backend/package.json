{
  "name": "japango-ai-backend",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ocr:ingest": "node --env-file=.env --import tsx ./scripts/ingest-japanese-ocr.ts",
    "japanese:search": "node --env-file=.env --import tsx ./scripts/test-japanese-search.ts",
    "lessons-v2:audit": "node --import tsx ./scripts/audit-jlpt-question-papers.ts",
    "lessons-v2:content-audit": "node --env-file=.env --import tsx ./scripts/audit-lessons-v2-content.ts",
    "lessons-v2:pilot": "node --import tsx ./scripts/seed-lessons-v2-pilot.ts",
    "audio-lessons:pilot": "node --env-file=.env --import tsx ./scripts/seed-audio-lesson-pilots.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "tsx": "^4.23.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
